library(dplyr)
library(tidyverse)
library(mlogit)
df <- read_csv("conjoint_data.csv")
glimpse(df)
# set seed for reproducibility
set.seed(123)
# define attributes
brand <- c("N", "P", "H") # Netflix, Prime, Hulu
ad <- c("Yes", "No")
price <- seq(8, 32, by=4)
# generate all possible profiles
profiles <- expand.grid(
brand = brand,
ad = ad,
price = price
)
m <- nrow(profiles)
# assign part-worth utilities (true parameters)
b_util <- c(N = 1.0, P = 0.5, H = 0)
a_util <- c(Yes = -0.8, No = 0.0)
p_util <- function(p) -0.1 * p
# number of respondents, choice tasks, and alternatives per task
n_peeps <- 100
n_tasks <- 10
n_alts <- 3
# function to simulate one respondent’s data
sim_one <- function(id) {
datlist <- list()
# loop over choice tasks
for (t in 1:n_tasks) {
# randomly sample 3 alts (better practice would be to use a design)
dat <- cbind(resp=id, task=t, profiles[sample(m, size=n_alts), ])
# compute deterministic portion of utility
dat$v <- b_util[dat$brand] + a_util[dat$ad] + p_util(dat$price) |> round(10)
# add Gumbel noise (Type I extreme value)
dat$e <- -log(-log(runif(n_alts)))
dat$u <- dat$v + dat$e
# identify chosen alternative
dat$choice <- as.integer(dat$u == max(dat$u))
# store task
datlist[[t]] <- dat
}
# combine all tasks for one respondent
do.call(rbind, datlist)
}
# simulate data for all respondents
conjoint_data <- do.call(rbind, lapply(1:n_peeps, sim_one))
# remove values unobservable to the researcher
conjoint_data <- conjoint_data[ , c("resp", "task", "brand", "ad", "price", "choice")]
# clean up
rm(list=setdiff(ls(), "conjoint_data"))
# Step 1: Prepare data
conjoint_data <- conjoint_data %>%
mutate(
ad = ifelse(ad == "Yes", 1, 0),
chid = paste(resp, task, sep = "_")
)
# Step 2: Create explicit alt ID (1, 2, 3 per task)
conjoint_data <- conjoint_data %>%
group_by(chid) %>%
mutate(alt_id = row_number()) %>%
ungroup()
# Step 3: Convert brand to factor (Hulu is baseline)
conjoint_data <- conjoint_data %>%
mutate(brand = factor(brand, levels = c("H", "P", "N")))
# Step 4: Use mlogit.data with alt_id instead of brand
mlogit_df <- mlogit.data(
data = conjoint_data,
choice = "choice",
shape = "long",
chid.var = "chid",
alt.var = "alt_id",     # now using a unique per-task alt ID
id.var = "resp"
)
# Step 1
# Filter and arrange data
library(dplyr)
X_data <- conjoint_data %>%
mutate(
netflix = ifelse(brand == "N", 1, 0),
prime = ifelse(brand == "P", 1, 0)
) %>%
arrange(resp, task, alt_id)  # ensure rows are ordered properly
# Step 2
log_likelihood <- function(params, data) {
beta_netflix <- params[1]
beta_prime   <- params[2]
beta_ads     <- params[3]
beta_price   <- params[4]
utilities <- with(data,
beta_netflix * netflix +
beta_prime   * prime +
beta_ads     * ad +
beta_price   * price
)
# Exponentiated utilities per task
data$exp_util <- exp(utilities)
# Sum of exp utilities per choice set (chid)
data <- data %>%
group_by(chid) %>%
mutate(denom = sum(exp_util)) %>%
ungroup()
# Probability of choosing each alternative
data$prob <- data$exp_util / data$denom
# Log-likelihood: sum only over chosen alternatives
log_lik <- sum(log(data$prob[data$choice == 1]))
# Return negative log-likelihood for minimization
return(-log_lik)
}
# Step 3
# Starting values
start_vals <- c(0, 0, 0, 0)
# Run optimization
fit <- optim(
par = start_vals,
fn = log_likelihood,
data = X_data,
hessian = TRUE,
method = "BFGS"
)
# MLE estimates
mle_estimates <- fit$par
names(mle_estimates) <- c("β_netflix", "β_prime", "β_ads", "β_price")
# Step 4
# Variance-covariance matrix from inverse Hessian
vcov_matrix <- solve(fit$hessian)
std_errors <- sqrt(diag(vcov_matrix))
# 95% Confidence Intervals
z <- qnorm(0.975)
ci_lower <- mle_estimates - z * std_errors
ci_upper <- mle_estimates + z * std_errors
# Combine into a table
results <- data.frame(
Estimate = mle_estimates,
Std.Error = std_errors,
CI.Lower = ci_lower,
CI.Upper = ci_upper
)
results
# Step 5
library(knitr)
kable(results, digits = 3, caption = "MLE Estimates with 95% Confidence Intervals")
# Step 6A
library(ggplot2)
results <- results %>%
mutate(Parameter = rownames(results))
ggplot(results, aes(x = Parameter, y = Estimate)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = CI.Lower, ymax = CI.Upper), width = 0.2) +
labs(title = "MLE Coefficient Estimates with 95% Confidence Intervals",
y = "Estimate", x = "Parameter") +
theme_minimal()
# Step 6B
predict_share <- function(profiles, coef) {
utilities <- with(profiles,
coef["β_netflix"] * netflix +
coef["β_prime"]   * prime +
coef["β_ads"]     * ad +
coef["β_price"]   * price
)
exp_util <- exp(utilities)
probs <- exp_util / sum(exp_util)
return(probs)
}
# Step 6C
# Simulate 3 competing options
profiles <- data.frame(
netflix = c(1, 0, 0),
prime   = c(0, 1, 0),
ad      = c(0, 1, 0),
price   = c(12, 8, 10)
)
# Predict market shares
predict_share(profiles, mle_estimates)
# Step 6D
sim_shares <- predict_share(profiles, mle_estimates)
bar_df <- data.frame(
Alternative = c("Netflix, No Ads, $12", "Prime, Ads, $8", "Hulu, No Ads, $10"),
Share = sim_shares
)
ggplot(bar_df, aes(x = Alternative, y = Share)) +
geom_col(fill = "steelblue") +
labs(title = "Simulated Choice Shares Based on MLE Estimates",
y = "Predicted Share", x = "") +
theme_minimal()
# Step 1
log_prior <- function(params) {
dnorm(params[1], 0, sqrt(5), log = TRUE) +  # beta_netflix
dnorm(params[2], 0, sqrt(5), log = TRUE) +  # beta_prime
dnorm(params[3], 0, sqrt(5), log = TRUE) +  # beta_ads
dnorm(params[4], 0, 1, log = TRUE)          # beta_price
}
# Step 2
log_posterior <- function(params, data) {
-log_likelihood(params, data) + log_prior(params)
}
# Step 3
set.seed(123)
n_iter <- 11000
params <- matrix(NA, nrow = n_iter, ncol = 4)
params[1, ] <- c(0, 0, 0, 0)  # starting values
proposal_sd <- c(0.05, 0.05, 0.05, 0.005)
accept <- rep(NA, n_iter)
for (i in 2:n_iter) {
current <- params[i - 1, ]
proposal <- rnorm(4, mean = current, sd = proposal_sd)
log_post_current <- log_posterior(current, X_data)
log_post_proposal <- log_posterior(proposal, X_data)
log_accept_ratio <- log_post_proposal - log_post_current
if (log(runif(1)) < log_accept_ratio) {
params[i, ] <- proposal
accept[i] <- 1
} else {
params[i, ] <- current
accept[i] <- 0
}
}
